# Copy to .env. Agents cannot read .env. The JIRA_ values are only for
# `pnpm seed:jira`, which rebuilds the test site's SYN project; Oriel itself
# reads Jira through Atlassian's MCP server in your agent (decision 0059).
JIRA_SITE=https://oriel.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Leave empty to run the agent on your own Claude Code, signed in (decision 0037).
ANTHROPIC_API_KEY=
# Fine-grained token for oriel-app/oriel only, used by `pnpm -s github`.
# Contents, Pull requests and Merge queues: read and write. No Administration,
# Secrets, Environments or Workflows.
GH_TOKEN=
# The test Slack workspace's app, made from scripts/slack-app.json, used only
# by `pnpm seed:slack`. Its Basic Information page has both values. User tokens
# are added by `pnpm seed:slack --add`, one per person who authorized it.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_USER_TOKENS=
