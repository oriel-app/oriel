# Copy to .env. Agents cannot read .env. Leave the JIRA_ values empty to
# connect Jira from the window instead, with `--jira live`.
JIRA_SITE=https://oriel.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
ANTHROPIC_API_KEY=
# Fine-grained token for oriel-app/oriel only, used by `pnpm -s github`.
# Contents, Pull requests and Merge queues: read and write. No Administration,
# Secrets, Environments or Workflows.
GH_TOKEN=
# The test Slack workspace's app, made from scripts/slack-app.json, used by
# `pnpm seed:slack`. Its Basic Information page has both values. User tokens
# are added by `pnpm seed:slack --add`, one per person who authorized it.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_USER_TOKENS=
