+// Concurrency and sign-in refusals: the Effect version only.
+describe("tool host (effect): concurrency and sign-in", () => {
+  const settle = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+  test("at most `concurrency` calls are out; the rest queue in order and go as slots free", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await effectHost(t.options);
+    const hang = failed(host.call({ server: "teams", tool: "hang", args: {} }));
+    const order: number[] = [];
+    const echoes = [1, 2, 3, 4].map((n) =>
+      host.call({ server: "teams", tool: "echo", args: { n } }).then((answer) => {
+        order.push(n);
+        return answer;
+      }),
+    );
+    const answers = await Promise.all(echoes);
+    assert.deepEqual(order, [1, 2, 3, 4]);
+    assert.deepEqual(
+      answers.map((answer) => answer.content),
+      [1, 2, 3, 4].map((n) => [{ type: "text", text: `{"n":${n}}` }]),
+    );
+    await host.close();
+    const gone = await hang;
+    assert.ok(gone instanceof CallFailed && gone.sent, String(gone));
+    assert.deepEqual(t.calls(), ["call hang", ...Array(4).fill("call echo")]);
+    t.done();
+  });
+
+  test("with every slot out, a queued call isn't sent; its run ending fails it unsent; a call out ending closes the host", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await effectHost(t.options);
+    const first = new AbortController();
+    const third = new AbortController();
+    const out1 = failed(host.call({ server: "teams", tool: "hang", args: {} }, first.signal));
+    const out2 = failed(host.call({ server: "teams", tool: "hang", args: {} }));
+    const queued3 = failed(host.call({ server: "teams", tool: "echo", args: {} }, third.signal));
+    const queued4 = failed(host.call({ server: "teams", tool: "echo", args: {} }));
+    await t.until(2);
+    await settle(50);
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    let at = performance.now();
+    third.abort();
+    const unsent = await queued3;
+    assert.ok(unsent instanceof CallFailed && !unsent.sent, String(unsent));
+    assert.ok(performance.now() - at < 100, "the queued call failed at once");
+    at = performance.now();
+    first.abort();
+    const [a, b, c] = await Promise.all([out1, out2, queued4]);
+    assert.ok(a instanceof CallFailed && a.sent, String(a));
+    assert.ok(b instanceof CallFailed && b.sent, String(b));
+    assert.ok(c instanceof CallFailed && !c.sent, String(c));
+    assert.ok(performance.now() - at < 1_000, "the host closed promptly");
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    await host.close();
+    assert.equal(alive(host.pid), false);
+    t.done();
+  });
+
+  test("a call out past its deadline closes the host: other calls out fail as sent, queued ones unsent", async () => {
+    const t = setup({}, { concurrency: 2, callMs: 150 });
+    const host = await effectHost(t.options);
+    const out1 = failed(host.call({ server: "teams", tool: "hang", args: {} }));
+    const out2 = failed(host.call({ server: "teams", tool: "hang", args: {} }));
+    const queued = failed(host.call({ server: "teams", tool: "echo", args: {} }));
+    const [a, b, c] = await Promise.all([out1, out2, queued]);
+    assert.ok(a instanceof CallFailed && a.sent, String(a));
+    assert.ok(b instanceof CallFailed && b.sent, String(b));
+    assert.ok(c instanceof CallFailed && !c.sent, String(c));
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    await host.close();
+    assert.equal(alive(host.pid), false);
+    t.done();
+  });
+
+  test("a server that needs signing in fails the call unsent, and closes the host", async () => {
+    const t = setup();
+    const host = await effectHost(t.options);
+    const refused = failed(host.call({ server: "teams", tool: "auth", args: {} }));
+    const queued = failed(host.call({ server: "teams", tool: "echo", args: {} }));
+    const error = await refused;
+    assert.ok(error instanceof CallFailed && !error.sent, String(error));
+    assert.equal(error.message, "teams needs signing in, in your own Claude Code");
+    const behind = await queued;
+    assert.ok(behind instanceof CallFailed && !behind.sent, String(behind));
+    const later = await failed(host.call({ server: "teams", tool: "echo", args: {} }));
+    assert.ok(later instanceof CallFailed && !later.sent, String(later));
+    assert.deepEqual(t.calls(), ["call auth"]);
+    await host.close();
+    assert.equal(alive(host.pid), false);
+    assert.equal(existsSync(host.dir), false);
+    t.done();
+  });
+
+  test("a sign-in refusal with other calls out: they fail as sent, nothing queued is sent", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await effectHost(t.options);
+    const out = failed(host.call({ server: "teams", tool: "hang", args: {} }));
+    await t.until(1);
+    const refused = failed(host.call({ server: "teams", tool: "auth", args: {} }));
+    const queued = failed(host.call({ server: "teams", tool: "echo", args: {} }));
+    const [a, b, c] = await Promise.all([out, refused, queued]);
+    assert.ok(a instanceof CallFailed && a.sent, String(a));
+    assert.ok(b instanceof CallFailed && !b.sent, String(b));
+    assert.equal(b.message, "teams needs signing in, in your own Claude Code");
+    assert.ok(c instanceof CallFailed && !c.sent, String(c));
+    assert.deepEqual(t.calls(), ["call hang", "call auth"]);
+    await host.close();
+    t.done();
+  });
+});
