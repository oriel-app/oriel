+// Only the plain host takes `concurrency` and names a server that needs
+// signing in.
+describe("tool host (plain): concurrency and signing in", () => {
+  const echo = (n: number) => ({ server: "teams", tool: "echo", args: { n } });
+  const hang = { server: "teams", tool: "hang", args: {} };
+
+  test("at most `concurrency` calls are out; the rest go in order as room frees", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await plainHost(t.options);
+    const ahead = failed(host.call(hang));
+    const settled: number[] = [];
+    const answers = await Promise.all(
+      [1, 2, 3].map((n) =>
+        host.call(echo(n)).then((answer) => {
+          settled.push(n);
+          return answer.content;
+        }),
+      ),
+    );
+    assert.deepEqual(settled, [1, 2, 3]);
+    assert.deepEqual(
+      answers,
+      [1, 2, 3].map((n) => [{ type: "text", text: `{"n":${n}}` }]),
+    );
+    assert.deepEqual(t.calls(), ["call hang", "call echo", "call echo", "call echo"]);
+    await host.close();
+    const gone = await ahead;
+    assert.ok(gone instanceof CallFailed && gone.sent);
+    t.done();
+  });
+
+  test("a queued call whose run ends fails at once and unsent while the calls out go on", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await plainHost(t.options);
+    const first = failed(host.call(hang));
+    const second = failed(host.call(hang));
+    const run = new AbortController();
+    const queued = host.call(echo(1), run.signal);
+    const behind = failed(host.call(echo(2)));
+    await t.until(2);
+    run.abort();
+    const error = await failed(queued);
+    assert.ok(error instanceof CallFailed && !error.sent, String(error));
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    await host.close();
+    const [a, b, c] = await Promise.all([first, second, behind]);
+    assert.ok(a instanceof CallFailed && a.sent);
+    assert.ok(b instanceof CallFailed && b.sent);
+    assert.ok(c instanceof CallFailed && !c.sent, String(c));
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    t.done();
+  });
+
+  test("a call out whose run ends closes the host: the other out fail as sent, the queued as unsent", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await plainHost(t.options);
+    const run = new AbortController();
+    const first = failed(host.call(hang, run.signal));
+    const second = failed(host.call(hang));
+    const queued = [failed(host.call(echo(1))), failed(host.call(echo(2)))];
+    await t.until(2);
+    run.abort();
+    const [a, b, ...rest] = await Promise.all([first, second, ...queued]);
+    assert.ok(a instanceof CallFailed && a.sent, String(a));
+    assert.ok(b instanceof CallFailed && b.sent, String(b));
+    for (const each of rest) assert.ok(each instanceof CallFailed && !each.sent, String(each));
+    await host.close();
+    assert.equal(alive(host.pid), false);
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    t.done();
+  });
+
+  test("a call out past its deadline fails as sent, and nothing queued is sent", async () => {
+    const t = setup({}, { concurrency: 2, callMs: 150 });
+    const host = await plainHost(t.options);
+    const out = [failed(host.call(hang)), failed(host.call(hang))];
+    const queued = failed(host.call(echo(1)));
+    const [a, b, c] = await Promise.all([...out, queued]);
+    assert.ok(a instanceof CallFailed && a.sent && /longer than 150/.test(a.message), String(a));
+    assert.ok(b instanceof CallFailed && b.sent, String(b));
+    assert.ok(c instanceof CallFailed && !c.sent, String(c));
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    await host.close();
+    t.done();
+  });
+
+  test("a server that needs signing in fails the call unsent, names the server, and closes the host", async () => {
+    const t = setup();
+    const host = await plainHost(t.options);
+    await host.call(echo(1));
+    const auth = host.call({ server: "teams", tool: "auth", args: {} });
+    const queued = failed(host.call(echo(2)));
+    const error = await failed(auth);
+    assert.ok(error instanceof CallFailed && !error.sent, String(error));
+    assert.equal(error.message, "teams needs signing in, in your own Claude Code");
+    const behind = await queued;
+    assert.ok(behind instanceof CallFailed && !behind.sent, String(behind));
+    const later = await failed(host.call(echo(3)));
+    assert.ok(later instanceof CallFailed && !later.sent);
+    await host.close();
+    assert.equal(alive(host.pid), false);
+    assert.deepEqual(t.calls(), ["call echo", "call auth"]);
+    t.done();
+  });
+
+  test("signing in needed while another call is out: that call fails as sent", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await plainHost(t.options);
+    const out = failed(host.call(hang));
+    await t.until(1);
+    const error = await failed(host.call({ server: "teams", tool: "auth", args: {} }));
+    assert.ok(error instanceof CallFailed && !error.sent);
+    assert.equal(error.message, "teams needs signing in, in your own Claude Code");
+    const gone = await out;
+    assert.ok(gone instanceof CallFailed && gone.sent, String(gone));
+    await host.close();
+    t.done();
+  });
+});
