+// Concurrency and sign-in refusals are the Effect version's only.
+describe("tool host (effect): concurrency and sign-in", () => {
+  const open = effectHost;
+  const echo = { server: "teams", tool: "echo", args: {} };
+  const hang = { server: "teams", tool: "hang", args: {} };
+
+  test("calls up to the concurrency go out at once, the rest queue in order", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await open(t.options);
+    const first = host.call(hang);
+    const second = host.call(hang);
+    const answers = [1, 2, 3].map((n) => host.call({ ...echo, args: { n } }));
+    await t.until(2);
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    const going = Promise.all([failed(first), failed(second), ...answers.map(failed)]);
+    await host.close();
+    const [a, b, ...queued] = await going;
+    for (const out of [a, b]) assert.ok(out instanceof CallFailed && out.sent, String(out));
+    for (const each of queued) assert.ok(each instanceof CallFailed && !each.sent, String(each));
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    t.done();
+  });
+
+  test("queued calls are sent in the order they were made", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await open(t.options);
+    const answers = await Promise.all(
+      [1, 2, 3, 4, 5].map((n) => host.call({ ...echo, args: { n } })),
+    );
+    assert.deepEqual(
+      answers.map((answer) => answer.content),
+      [1, 2, 3, 4, 5].map((n) => [{ type: "text", text: `{"n":${n}}` }]),
+    );
+    assert.equal(t.calls().length, 5);
+    await host.close();
+    t.done();
+  });
+
+  test("with calls out, a queued call whose run ends fails unsent; a call out whose run ends fails sent and closes the host", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await open(t.options);
+    const runA = new AbortController();
+    const runQ = new AbortController();
+    const a = host.call(hang, runA.signal);
+    const b = host.call(hang);
+    const queued = host.call(echo, runQ.signal);
+    const behind = host.call(echo);
+    await t.until(2);
+    runQ.abort();
+    const early = await failed(queued);
+    assert.ok(early instanceof CallFailed && !early.sent, String(early));
+    const at = performance.now();
+    runA.abort();
+    const [first, other, last] = await Promise.all([failed(a), failed(b), failed(behind)]);
+    assert.ok(performance.now() - at < 1_000);
+    assert.ok(first instanceof CallFailed && first.sent, String(first));
+    assert.ok(other instanceof CallFailed && other.sent, String(other));
+    assert.ok(last instanceof CallFailed && !last.sent, String(last));
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    await host.close();
+    assert.equal(alive(host.pid), false);
+    t.done();
+  });
+
+  test("a call out past its deadline closes the host: the other call out fails sent, the queued one unsent", async () => {
+    const t = setup({}, { concurrency: 2, callMs: 150 });
+    const host = await open(t.options);
+    const a = host.call(hang);
+    await t.until(1);
+    const b = host.call(hang);
+    const queued = host.call(echo);
+    const [first, other, last] = await Promise.all([failed(a), failed(b), failed(queued)]);
+    assert.ok(first instanceof CallFailed && first.sent, String(first));
+    assert.match(first.message, /longer than 150/);
+    assert.ok(other instanceof CallFailed && other.sent, String(other));
+    assert.ok(last instanceof CallFailed && !last.sent, String(last));
+    assert.deepEqual(t.calls(), ["call hang", "call hang"]);
+    await host.close();
+    assert.equal(alive(host.pid), false);
+    t.done();
+  });
+
+  test("a server that needs signing in fails the call unsent and closes the host", async () => {
+    const t = setup();
+    const host = await open(t.options);
+    const refused = host.call({ server: "teams", tool: "auth", args: {} });
+    const queued = host.call(echo);
+    const error = await failed(refused);
+    assert.ok(error instanceof CallFailed, String(error));
+    assert.equal(error.sent, false);
+    assert.equal(error.message, "teams needs signing in, in your own Claude Code");
+    const next = await failed(queued);
+    assert.ok(next instanceof CallFailed && !next.sent, String(next));
+    const later = await failed(host.call(echo));
+    assert.ok(later instanceof CallFailed && !later.sent, String(later));
+    assert.deepEqual(t.calls(), ["call auth"]);
+    await host.close();
+    assert.equal(alive(host.pid), false);
+    assert.equal(existsSync(host.dir), false);
+    t.done();
+  });
+
+  test("needing sign-in with another call out: that call fails sent, nothing queued is sent", async () => {
+    const t = setup({}, { concurrency: 2 });
+    const host = await open(t.options);
+    const out = host.call(hang);
+    await t.until(1);
+    const refused = host.call({ server: "teams", tool: "auth", args: {} });
+    const queued = host.call(echo);
+    const [other, error, last] = await Promise.all([failed(out), failed(refused), failed(queued)]);
+    assert.ok(error instanceof CallFailed && !error.sent, String(error));
+    assert.equal(error.message, "teams needs signing in, in your own Claude Code");
+    assert.ok(other instanceof CallFailed && other.sent, String(other));
+    assert.ok(last instanceof CallFailed && !last.sent, String(last));
+    assert.deepEqual(t.calls(), ["call hang", "call auth"]);
+    await host.close();
+    t.done();
+  });
+});
