{
  "name": "oriel",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test && node scripts/check-repo.ts",
    "typecheck": "tsc -b && tsc -p packages/web --noEmit",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "github": "node scripts/github.ts",
    "seed:jira": "node scripts/seed-jira.ts",
    "record:jira": "node scripts/record-jira.ts",
    "seed:slack": "node scripts/seed-slack.ts",
    "evals": "node packages/evals/src/cli.ts",
    "test": "NODE_COMPILE_CACHE=node_modules/.cache/node node --test",
    "dev": "pnpm --filter @oriel/web build && node packages/server/src/main.ts",
    "drive": "node scripts/drive.ts",
    "shots": "pnpm --filter @oriel/web build && node scripts/shots.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
