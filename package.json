{
  "name": "oriel",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test && node scripts/check-repo.ts && pnpm ds:check && pnpm -r --if-present run evals:ci",
    "typecheck": "tsc -b && tsc -p packages/web --noEmit && tsc -p packages/desktop/shell && tsc -p packages/desktop/probe && tsc -p packages/design-system",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "github": "node scripts/github.ts",
    "seed:jira": "node scripts/seed-jira.ts",
    "seed:slack": "node scripts/seed-slack.ts",
    "evals": "node packages/evals/src/cli.ts",
    "evals:noticed": "node packages/evals/src/noticed/cli.ts",
    "test": "node scripts/run-tests.ts",
    "dev": "pnpm --filter @oriel/web build && node packages/server/src/main.ts",
    "desktop:server": "pnpm --filter @oriel/web build && node scripts/desktop-server.ts",
    "drive": "node scripts/drive.ts",
    "shots": "pnpm --filter @oriel/web build && node scripts/shots.ts",
    "shots:diff": "node scripts/shots-diff.ts",
    "ui-test": "pnpm --filter @oriel/web build && node scripts/ui-tests.ts",
    "perf": "pnpm --filter @oriel/web build && node scripts/perf.ts",
    "desktop": "node packages/desktop/src/bundle.ts",
    "desktop:try": "node scripts/desktop-try.ts",
    "desktop:debug-flags": "node scripts/desktop-debug-flags.ts",
    "sketch-frames": "pnpm --filter @oriel/web build && node scripts/sketch-frames.ts",
    "design": "node packages/design-system/src/server.ts",
    "ui-check": "node packages/design-system/scripts/ui-check.ts",
    "ds": "node packages/design-system/src/cli.ts",
    "ds:check": "node packages/design-system/scripts/check.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
